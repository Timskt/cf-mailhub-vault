{
  "name": "cf-mailhub-vault",
  "version": "1.0.0",
  "description": "Cloudflare All-in-One Multi-Source Mailbox & Platform Account Vault",
  "main": "src/index.ts",
  "type": "module",
  "packageManager": "pnpm@11.1.2",
  "engines": {
    "node": ">=22",
    "pnpm": ">=11"
  },
  "scripts": {
    "docs:generate": "tsx scripts/generate-api-docs.ts",
    "docs:check": "tsx scripts/generate-api-docs.ts --check",
    "dev": "pnpm build:web && concurrently --kill-others -n web,worker \"vite build --watch\" \"wrangler dev --local --config wrangler.local.jsonc\"",
    "deploy": "pnpm build:web && wrangler deploy --minify",
    "build": "pnpm build:web && wrangler deploy --dry-run --config wrangler.local.jsonc --outdir dist --minify",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.connector.json",
    "test": "tsx --test --test-concurrency=1 tests/*.test.ts",
    "test:e2e": "pnpm build:web && playwright test",
    "test:sdk:python": "python3 -m unittest discover -s tests -p 'sdk_python_test.py'",
    "typecheck:sdk": "tsc --noEmit -p sdk/typescript/tsconfig.json",
    "db:migrate:local": "wrangler d1 migrations apply DB --local --config wrangler.local.jsonc",
    "dev:seed": "wrangler d1 execute DB --local --config wrangler.local.jsonc --file scripts/seed-local.sql",
    "cf-typegen": "wrangler types",
    "dev:worker": "wrangler dev --local --config wrangler.local.jsonc",
    "build:web": "vite build",
    "format:check": "prettier --check web vite.config.ts index.html components.json",
    "connector:dev": "tsx connector/index.ts",
    "test:storage": "tsx --test --test-concurrency=1 tests/storage.integration.ts",
    "build:connector": "esbuild connector/index.ts --bundle --platform=node --target=node22 --format=esm --packages=external --outfile=dist/connector.mjs"
  },
  "keywords": [
    "cloudflare",
    "workers",
    "temp-mail",
    "outlook",
    "vault",
    "account-manager"
  ],
  "author": "Timskt",
  "license": "MIT",
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@hono/node-server": "^2.1.8",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.2",
    "hono": "^4.7.2",
    "ioredis": "^6.0.0",
    "lucide-react": "^1.72.0",
    "mongodb": "^7.9.0",
    "mysql2": "^3.24.6",
    "postal-mime": "^4.1.4",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@cloudflare/workers-types": "^5.20261114.1",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "concurrently": "^10.0.7",
    "esbuild": "^0.28.2",
    "miniflare": "5.20261110.0-beta",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^5.8.2",
    "vite": "^8.3.8",
    "wrangler": "^4.151.3"
  }
}
